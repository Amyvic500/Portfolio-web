# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

PORT=4000

# Change this to a strong password — this is what you type in to access /admin.html
ADMIN_PASSWORD=changeme123

# Any long random string — used to sign admin login sessions
JWT_SECRET=please-change-this-to-a-long-random-string

# The email address YOU want to receive contact-form enquiries at
OWNER_EMAIL=victoriamarachi450@gmail.com

# ── Brevo SMTP settings (free tier: https://app.brevo.com) ──
# 1. Create a free Brevo account
# 2. Go to Settings -> SMTP & API -> SMTP tab
# 3. Copy your SMTP login (usually your Brevo account email) and generate an SMTP key (this is SMTP_PASS, not your account password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM="Victoria Amarachi Philip <no-reply@yourdomain.com>"

# ── MySQL connection ──
# Local dev: whatever your local MySQL/XAMPP root credentials are.
# On a host like Railway/Render/cPanel, they'll give you these values directly.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db
